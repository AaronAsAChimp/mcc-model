---
import Document from '../layouts/Document.astro';
import { FantasyEvent } from '../components/fantasy-event/index.tsx';
---
<Document>
  <main>
    <h1>Fantasy MCC</h1>
    <div class="intro">
      <p>Build your own event by choosing eight games and filling the ten teams, then run the prediction model. It all runs in your browser, nothing gets set to our servers. Like... I don't even have servers.</p>
      <a href="/about">How it works</a>
    </div>
    <FantasyEvent client:load />
  </main>
</Document>

<style>
.intro {
  margin: 1rem 0 2rem;
}
</style>
